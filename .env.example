# URL publique du site (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr
# Indexation par les moteurs de recherche — laisser à false pour la démonstration
NEXT_PUBLIC_SITE_INDEXABLE=false
# Active l'envoi réel du formulaire (implémenter src/app/api/contact/route.ts avant)
NEXT_PUBLIC_CONTACT_ENABLED=false
